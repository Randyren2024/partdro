{
  "name": "partdro-nuxt",
  "private": true,
  "type": "module",
  "description": "Nuxt 4 + Supabase + Cloudflare Pages migration of partdro site (droneworld.tech)",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build --preset=cloudflare_pages",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy:cf": "wrangler pages deploy dist --project-name=partdro-nuxt",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@fontsource-variable/inter": "^5.1.0",
    "@nuxtjs/color-mode": "^3.5.0",
    "@nuxtjs/i18n": "^9.0.0",
    "@pinia/nuxt": "^0.9.0",
    "@stripe/stripe-js": "^4.9.0",
    "@supabase/supabase-js": "^2.45.0",
    "ant-design-vue": "^4.2.0",
    "nuxt": "^4.0.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vue-tsc": "^2.1.0",
    "wrangler": "^4.158.0"
  },
  "version": "1.0.0"
}
