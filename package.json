{
  "name": "partdro-nuxt",
  "private": true,
  "type": "module",
  "description": "Droneworld.tech / Partdro — Nuxt 4 primary application with temporary legacy build tooling",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy": "wrangler pages deploy dist",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "dev:legacy": "vite --config legacy-vite/vite.config.ts",
    "build:legacy": "npx playwright install chromium && vite build --config legacy-vite/vite.config.ts && node scripts/inject-seo-links.mjs && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs",
    "preview:legacy": "vite preview --config legacy-vite/vite.config.ts",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "prerender": "node scripts/prerender.mjs",
    "generate-favicons": "node scripts/generate-favicons.js",
    "netlify:dev": "netlify dev",
    "landing:c500:dev": "vite --config landing/eavision-c500/vite.config.mjs",
    "landing:c500:build": "vite build --config landing/eavision-c500/vite.config.mjs && node landing/eavision-c500/scripts/postbuild.mjs && node landing/eavision-c500/scripts/prerender.mjs",
    "landing:c500:serve": "node landing/eavision-c500/scripts/serve.mjs",
    "landing:c500:optimize": "node landing/eavision-c500/scripts/optimize-images.mjs",
    "landing:c500:test": "node landing/eavision-c500/scripts/test-local.mjs",
    "landing:u15:dev": "vite --config landing/u15/vite.config.mjs",
    "landing:u15:build": "vite build --config landing/u15/vite.config.mjs && node landing/u15/scripts/postbuild.mjs && node landing/u15/scripts/prerender.mjs",
    "landing:u15:serve": "node landing/u15/scripts/serve.mjs",
    "landing:u15:optimize": "node landing/u15/scripts/optimize-images.mjs",
    "landing:vf50p:dev": "vite --config landing/vf50p/vite.config.mjs",
    "landing:vf50p:build": "vite build --config landing/vf50p/vite.config.mjs && node landing/vf50p/scripts/postbuild.mjs && node landing/vf50p/scripts/prerender.mjs",
    "landing:vf50p:serve": "node landing/vf50p/scripts/serve.mjs"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@fontsource-variable/inter": "^5.1.0",
    "@nuxtjs/color-mode": "^3.5.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^0.9.0",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vueuse/motion": "^3.0.3",
    "ant-design-vue": "^4.2.0",
    "nuxt": "^4.0.0",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sortablejs": "^1.15.7",
    "stripe": "^22.2.3",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.5.0",
    "vue3-map-chart": "^0.2.0",
    "vuedraggable": "^4.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@netlify/functions": "^4.3.0",
    "@playwright/test": "^1.60.0",
    "@types/sortablejs": "^1.15.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "cheerio": "^1.2.0",
    "e2b": "2.31.0",
    "esbuild": "^0.28.2",
    "netlify-cli": "^26.1.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "typescript": "^5.6.0",
    "vue-tsc": "^2.1.0",
    "vite": "^5.0.0",
    "wrangler": "^4.158.0"
  }
}
