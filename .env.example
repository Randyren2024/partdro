# Supabase Configuration
# VITE_ 前缀 → 会打进前端 bundle（仅放可公开的值）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-side only（Netlify Functions 运行时读取，切勿加 VITE_ 前缀）
# 在 Netlify → Site configuration → Environment variables 中配置
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 本地 IOPaint 服务（可选，默认 http://localhost:8080；仅本机直连，不经 Netlify）
# VITE_IOPAINT_URL=http://localhost:8080

# 本地 Flux/wanx 局部重绘服务（可选，默认 http://localhost:5000；浏览器直连，Flask 已放开 CORS）
# VITE_FLUX_EDIT_URL=http://localhost:5000

# Stripe Configuration (to be added later)
# VITE_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# SendGrid Configuration (to be added later)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SENDGRID_TO_EMAIL=

# Aliyun DirectMail（阿里云邮件推送）— inquiries 表单新留言通知邮件
# ⚠️ Server-side only：配在阿里云 FC 函数的环境变量里，切勿加 VITE_ 前缀
DIRECTMAIL_ACCESS_KEY_ID=
DIRECTMAIL_ACCESS_KEY_SECRET=
# 已通过验证的发信地址（DirectMail 控制台 → 发信地址）
DIRECTMAIL_ACCOUNT=noreply@droneworld.tech
# DIRECTMAIL_REGION=cn-hangzhou
# DIRECTMAIL_ENDPOINT=
# 收件人，默认 info@droneworld.tech
# INQUIRY_NOTIFY_TO=info@droneworld.tech
# Supabase Database Webhook 共享密钥（自定义请求头 x-webhook-secret，两边必须一致）
INQUIRY_WEBHOOK_SECRET=
