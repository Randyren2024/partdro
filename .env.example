# Public catalogue reads (anon/publishable key only)
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only: required by the inquiry endpoint. Never expose to client code.
NUXT_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NUXT_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional analytics
NUXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NUXT_PUBLIC_SITE_URL=https://www.droneworld.tech
