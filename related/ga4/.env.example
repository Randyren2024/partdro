# ============================================================
# Google Analytics 4 (GA4) —— 凭据模板
# 复制为 .env 后填写
# ============================================================

# OAuth 客户端（应用身份，来自 Cloud 项目 artful-striker-458704-g1）
# 与 gtm/、gsc/ 共用同一份客户端；能看到哪些 GA4 数据由【授权账号】决定
GA4_CLIENT_ID=<Cloud 项目 → 凭据 → OAuth 客户端 ID>
GA4_CLIENT_SECRET=<对应密钥>

# 刷新令牌（npm run auth 生成，属于授权账号；Testing 状态下 7 天过期）
GA4_REFRESH_TOKEN=

# 可选默认值（留空则自动探测；不唯一时需用 --account / --property 指定）
GA4_ACCOUNT_ID=
GA4_PROPERTY_ID=
