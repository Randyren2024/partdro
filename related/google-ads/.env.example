# Google Ads API 凭据（全部不带空格，纯数字 ID 去掉连字符）
# 开发者令牌：MCC (ads.google.com → 工具 → API 中心) 获取
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth 客户端（console.cloud.google.com → 凭据 → OAuth 客户端 ID → 桌面应用）
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# 刷新令牌（运行 npm run auth 生成）
GOOGLE_ADS_REFRESH_TOKEN=
# 广告账户客户 ID（10-11 位纯数字，即页面右上角 xxx-xxx-xxxx 去掉连字符）
GOOGLE_ADS_CUSTOMER_ID=
# 若开发者令牌来自 MCC 管理账号，填 MCC 的客户 ID；否则留空
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
