# 复用 Google Ads 的 OAuth 客户端（Cloud 项目 artful-striker-458704-g1）
# 需在该项目启用 "Google Search Console API"
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
# 运行 npm run auth 生成（scope: https://www.googleapis.com/auth/webmasters）
GSC_REFRESH_TOKEN=
# GSC 属性：域名属性用 sc-domain:droneworld.tech；URL 前缀属性用 https://www.droneworld.tech/
GSC_SITE_URL=sc-domain:droneworld.tech